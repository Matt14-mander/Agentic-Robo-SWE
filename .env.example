# Model provider switch.
# Allowed values: anthropic | openai | deepseek
MODEL_PROVIDER=deepseek

# API keys. Fill the one for the active provider; leave the others as placeholder.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Code execution sandbox backend.
# Allowed values:
#   local  - subprocess + tempdir (default; fast; NOT a real sandbox)
#   e2b    - E2B Code Interpreter (cloud Firecracker microVM; real isolation)
EXECUTOR_BACKEND=local

# Required only when EXECUTOR_BACKEND=e2b. Sign up at https://e2b.dev to get a key.
E2B_API_KEY=e2b_4530be619f19c0d71147b057615b975b9fe04db3

# LangSmith observability (optional). Enable to upload traces to smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-robo-swe
