# Model provider switch.
# Allowed values: anthropic | openai | deepseek
MODEL_PROVIDER=deepseek

# API keys. Fill the one for the active provider; leave the others as placeholder.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# LangSmith observability (optional). Enable to upload traces to smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-robo-swe
